{
  "manifest_version": 3,
  "name": "Semantic AI Agent Widget",
  "version": "1.1",
  "description": "AI widget that semantically navigates websites to find relevant content.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}