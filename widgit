from playwright.sync_api import sync_playwright, TimeoutError
from bs4 import BeautifulSoup
from urllib.parse import urljoin, urlparse, urldefrag

from sentence_transformers import SentenceTransformer
from sklearn.metrics.pairwise import cosine_similarity

# ================= CONFIG =================
MAX_DEPTH = 10

TIMEOUT = 15000  # ms
TOP_K_LINKS = 3   # follow only top-k intent-matched links
SIM_THRESHOLD = 0.25  # minimum similarity to follow

# =========================================

# Load NLP model once
model = SentenceTransformer("all-MiniLM-L6-v2")


def normalize_url(url):
    url, _ = urldefrag(url)
    return url.rstrip("/")


def extract_navigation(html, base_url):
    soup = BeautifulSoup(html, "html.parser")
    nav_items = []

    for a in soup.find_all("a", href=True):
        text = a.get_text(strip=True)
        href = normalize_url(urljoin(base_url, a["href"]))

        if text and href.startswith("http"):
            nav_items.append({
                "label": text,
                "target": href,
                "type": "link"
            })

    return nav_items


def score_links_by_intent(user_query, nav_items):
    labels = [item["label"] for item in nav_items]

    if not labels:
        return []

    query_embedding = model.encode([user_query])
    label_embeddings = model.encode(labels)

    scores = cosine_similarity(query_embedding, label_embeddings)[0]

    for item, score in zip(nav_items, scores):
        item["score"] = float(score)

    # Sort by relevance
    nav_items.sort(key=lambda x: x["score"], reverse=True)

    return nav_items


def crawl_site(start_url, user_query):
    visited = set()
    graph = {}

    start_domain = urlparse(start_url).netloc

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)

        def crawl(url, depth):
            url = normalize_url(url)

            if depth > MAX_DEPTH or url in visited:
                return

            print(f"\n🕷 Crawling: {url} (depth={depth})")
            visited.add(url)

            page = browser.new_page()
            try:
                page.goto(url, timeout=TIMEOUT)
                page.wait_for_load_state("networkidle", timeout=TIMEOUT)
                html = page.content()
            except TimeoutError:
                print(f"⚠️ Timeout: {url}")
                page.close()
                return

            nav_items = extract_navigation(html, url)

            # 🔥 SCORE LINKS BY USER INTENT
            scored_links = score_links_by_intent(user_query, nav_items)

            graph[url] = scored_links

            page.close()

            # Follow only top-K relevant links
            for item in scored_links[:TOP_K_LINKS]:
                target = item["target"]
                score = item["score"]

                if score < SIM_THRESHOLD:
                    continue

                if target and urlparse(target).netloc == start_domain:
                    print(f"   ➜ Following: {item['label']} (score={score:.2f})")
                    crawl(target, depth + 1)

        crawl(start_url, 0)
        browser.close()

    return graph


# ================== RUN ==================
if __name__ == "__main__":
    START_URL = "https://en.wikipedia.org/wiki/Main_Page"
    USER_QUERY = input("🎯 What are you looking for? ")

    navigation_graph = crawl_site(START_URL, USER_QUERY)

    print("\n\n========= FINAL GRAPH =========")
    for page, links in navigation_graph.items():
        print(f"\nPAGE: {page}")
        for link in links[:5]:
            print(f" └─ {link['label']} → {link['target']} (score={link['score']:.2f})")
