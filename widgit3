import os
import json

def create_project():
    print("Initializing Semantic AI Widget setup...")

    # FILE 1: manifest.json

    manifest_content = {
      "manifest_version": 3,
      "name": "Semantic AI Agent Widget",
      "version": "1.0",
      "description": "AI widget that follows you across websites to find relevant content.",
      "permissions": [
        "activeTab",
        "scripting"
      ],
      "host_permissions": [
        "http://localhost:5000/*"
      ],
      "content_scripts": [
        {
          "matches": ["<all_urls>"],
          "js": ["content.js"],
          "css": ["style.css"]
        }
      ]
    }


    # FILE 2: style.css

    style_content = """
#semantic-ai-widget {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 250px;
    background: #1e1e1e;
    color: white;
    border: 2px solid #ff4b4b;
    border-radius: 12px;
    padding: 15px;
    z-index: 999999;
    font-family: Arial, sans-serif;
    box-shadow: 0 5px 15px rgba(0,0,0,0.5);
}
"""

    # FILE 3: content.js

    js_content = """
console.log("Semantic AI Widget: Active");

"""

    with open("manifest.json", "w", encoding="utf-8") as f:
        json.dump(manifest_content, f, indent=2)
    print("Generated: manifest.json")

    with open("style.css", "w", encoding="utf-8") as f:
        f.write(style_content.strip())
    print("Generated: style.css")

    with open("content.js", "w", encoding="utf-8") as f:
        f.write(js_content.strip())
    print("Generated: content.js")

    print("\nSUCCESS: Extension files created!")
    print("ACTION: Open chrome://extensions/ -> 'Load Unpacked' -> Select this folder.")

if __name__ == "__main__":
    create_project()
